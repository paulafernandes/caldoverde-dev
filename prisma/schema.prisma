// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model BusinessSettings {
  id          String  @id @default("business")
  name        String
  logoPath    String?
  faviconPath String?
  email       String?
  phone       String?
  mobilePhone String?

  addressLine1           String?
  addressLine2           String?
  postalCode             String?
  city                   String?
  countryCode            String?
  administrativeAreaCode String?
  locationUrl            String?

  taxId                        String?
  fiscalAddressSameAsBusiness  Boolean @default(true)
  fiscalAddressLine1           String?
  fiscalAddressLine2           String?
  fiscalPostalCode             String?
  fiscalCity                   String?
  fiscalCountryCode            String?
  fiscalAdministrativeAreaCode String?

  primaryActionUrl String?
  defaultLanguage  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translations BusinessSettingsTranslation[]
  languages    BusinessLanguage[]
  socialLinks  BusinessSocialLink[]
  openingHours BusinessOpeningHour[]
}

model BusinessSettingsTranslation {
  id             Int              @id @default(autoincrement())
  settingsId     String
  language       String
  seoTitle       String?
  seoDescription String?
  settings       BusinessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, language])
  @@index([language])
}

model BusinessLanguage {
  id         Int              @id @default(autoincrement())
  settingsId String
  language   String
  locale     String
  isEnabled  Boolean          @default(true)
  position   Int              @default(0)
  settings   BusinessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, language])
  @@index([settingsId, position])
}

model BusinessSocialLink {
  id         Int              @id @default(autoincrement())
  settingsId String
  platform   String
  url        String
  position   Int              @default(0)
  isVisible  Boolean          @default(true)
  settings   BusinessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, position])
}

// dayOfWeek: 1 = segunda … 7 = domingo. Horas "HH:MM"; se closesAt for anterior
// a opensAt, o intervalo termina no dia seguinte. Um dia sem linhas está fechado.
model BusinessOpeningHour {
  id         Int              @id @default(autoincrement())
  settingsId String
  dayOfWeek  Int
  opensAt    String
  closesAt   String
  settings   BusinessSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, dayOfWeek])
}

model MediaAsset {
  id           Int                     @id @default(autoincrement())
  imagePath    String
  category     String?
  position     Int                     @default(0)
  isVisible    Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations MediaAssetTranslation[]

  @@index([position])
}

model MediaAssetTranslation {
  id       Int        @id @default(autoincrement())
  mediaId  Int
  language String
  altText  String?
  caption  String?
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, language])
  @@index([language])
}

model MenuCategory {
  id            Int                       @id @default(autoincrement())
  slug          String                    @unique
  imagePath     String?
  position      Int                       @default(0)
  isVisible     Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  translations  MenuCategoryTranslation[]
  subcategories MenuSubcategory[]
  items         MenuItem[]

  @@index([position])
}

model MenuCategoryTranslation {
  id            Int          @id @default(autoincrement())
  categoryId    Int
  language      String
  label         String
  title         String
  highlightText String?
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([language])
}

model MenuSubcategory {
  id           Int                          @id @default(autoincrement())
  categoryId   Int
  position     Int                          @default(0)
  isVisible    Boolean                      @default(true)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  category     MenuCategory                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations MenuSubcategoryTranslation[]
  items        MenuItem[]

  @@index([categoryId, position])
}

model MenuSubcategoryTranslation {
  id            Int             @id @default(autoincrement())
  subcategoryId Int
  language      String
  name          String
  subcategory   MenuSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, language])
  @@index([language])
}

model MenuItem {
  id            Int                   @id @default(autoincrement())
  categoryId    Int
  subcategoryId Int?
  imagePath     String?
  priceText     String?
  position      Int                   @default(0)
  isVisible     Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   MenuSubcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  translations  MenuItemTranslation[]

  @@index([categoryId, position])
  @@index([subcategoryId, position])
}

model MenuItemTranslation {
  id          Int      @id @default(autoincrement())
  itemId      Int
  language    String
  name        String
  description String
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language])
  @@index([language])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
